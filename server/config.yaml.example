server:
  name: Mutsumi Server
  host: "::"
  port: 12091
  reload: false
  ssl:
    enabled: false
    certfile: ./server.crt
    keyfile: ./server.key
logging:
  level: INFO
  directory: logs
  retention_days: 7
storage:
  data_path: ./data
  # How long directory-size scans are reused for the storage page.
  # Set to 0 to always rescan; clients can also pass ?refresh=true.
  status_cache_seconds: 60
database_url: sqlite+aiosqlite:///./data/mutsumi.db
updates:
  repository: mom0ka27/Mutsumi
  asset_template: mutsumi-server-{tag}.zip
  default_branch: main
  channel: release
auth:
  secret_key: CHANGE_ME_TO_A_SECURE_RANDOM_VALUE
  algorithm: HS256
  access_token_expire_minutes: 1440
qbittorrent:
  url: http://localhost:1234
  username: ''
  password: ''
  download_path: ./data
  share_ratio_limit: 3.0
subscription:
  enabled: true
  interval_minutes: 15
  cold_start_days: 7
  max_pages_per_sweep: 5
  # 每部番用几个名字（中文名 / 原名 / 别名）各查一次，结果合并去重
  max_name_variants: 4
  auto_import: true
